@.str = private unnamed_addr constant [12 x i8] c"loop-exit-i\00", align 1, !dbg !0

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main() #0 !dbg !17 {
entry:
  %retval = alloca i32, align 4
  %i = alloca i32, align 4
  store i32 0, ptr %retval, align 4
    #dbg_declare(ptr %i, !22, !DIExpression(), !23)
  store i32 0, ptr %i, align 4, !dbg !23
  br label %while.cond, !dbg !24

while.cond:                                       ; preds = %while.body, %entry
  %0 = load i32, ptr %i, align 4, !dbg !25
  %cmp = icmp slt i32 %0, 4, !dbg !26
  br i1 %cmp, label %while.body, label %while.end, !dbg !24

while.body:                                       ; preds = %while.cond
  %1 = load i32, ptr %i, align 4, !dbg !27
  %add = add nsw i32 %1, 1, !dbg !28
  store i32 %add, ptr %i, align 4, !dbg !29
  br label %while.cond, !dbg !24, !llvm.loop !30

while.end:                                        ; preds = %while.cond
  %2 = load i32, ptr %i, align 4, !dbg !33
  call void @svf_print(i32 noundef %2, ptr noundef @.str), !dbg !34
  %3 = load i32, ptr %i, align 4, !dbg !35
  %cmp1 = icmp eq i32 %3, 4, !dbg !36
  call void @svf_assert(i1 noundef zeroext %cmp1), !dbg !37
  ret i32 0, !dbg !38
}

declare void @svf_print(i32 noundef, ptr noundef) #1

declare void @svf_assert(i1 noundef zeroext) #1

