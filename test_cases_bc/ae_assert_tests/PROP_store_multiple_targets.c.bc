@.str = private unnamed_addr constant [7 x i8] c"weak-x\00", align 1, !dbg !0
@.str.1 = private unnamed_addr constant [7 x i8] c"weak-y\00", align 1, !dbg !7

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main(i32 noundef %argc, ptr noundef %argv) #0 !dbg !19 {
entry:
  %retval = alloca i32, align 4
  %argc.addr = alloca i32, align 4
  %argv.addr = alloca ptr, align 8
  %expected_x = alloca i32, align 4
  %expected_y = alloca i32, align 4
  %x = alloca i32, align 4
  %y = alloca i32, align 4
  %pointer = alloca ptr, align 8
  store i32 0, ptr %retval, align 4
  store i32 %argc, ptr %argc.addr, align 4
    #dbg_declare(ptr %argc.addr, !26, !DIExpression(), !27)
  store ptr %argv, ptr %argv.addr, align 8
    #dbg_declare(ptr %argv.addr, !28, !DIExpression(), !29)
    #dbg_declare(ptr %expected_x, !30, !DIExpression(), !31)
  %0 = load i32, ptr %argc.addr, align 4, !dbg !32
  %cmp = icmp sgt i32 %0, 1, !dbg !33
  %1 = zext i1 %cmp to i64, !dbg !32
  %cond = select i1 %cmp, i32 1, i32 2, !dbg !32
  store i32 %cond, ptr %expected_x, align 4, !dbg !31
    #dbg_declare(ptr %expected_y, !34, !DIExpression(), !35)
  %2 = load i32, ptr %argc.addr, align 4, !dbg !36
  %cmp1 = icmp sgt i32 %2, 1, !dbg !37
  %3 = zext i1 %cmp1 to i64, !dbg !36
  %cond2 = select i1 %cmp1, i32 2, i32 3, !dbg !36
  store i32 %cond2, ptr %expected_y, align 4, !dbg !35
    #dbg_declare(ptr %x, !38, !DIExpression(), !39)
  store i32 1, ptr %x, align 4, !dbg !39
    #dbg_declare(ptr %y, !40, !DIExpression(), !41)
  store i32 3, ptr %y, align 4, !dbg !41
    #dbg_declare(ptr %pointer, !42, !DIExpression(), !44)
  %4 = load i32, ptr %argc.addr, align 4, !dbg !45
  %cmp3 = icmp sgt i32 %4, 1, !dbg !46
  br i1 %cmp3, label %cond.true, label %cond.false, !dbg !45

cond.true:                                        ; preds = %entry
  br label %cond.end, !dbg !45

cond.false:                                       ; preds = %entry
  br label %cond.end, !dbg !45

cond.end:                                         ; preds = %cond.false, %cond.true
  %cond4 = phi ptr [ %x, %cond.true ], [ %y, %cond.false ], !dbg !45
  store ptr %cond4, ptr %pointer, align 8, !dbg !44
  %5 = load ptr, ptr %pointer, align 8, !dbg !47
  store i32 2, ptr %5, align 4, !dbg !48
  %6 = load i32, ptr %x, align 4, !dbg !49
  call void @svf_print(i32 noundef %6, ptr noundef @.str), !dbg !50
  %7 = load i32, ptr %y, align 4, !dbg !51
  call void @svf_print(i32 noundef %7, ptr noundef @.str.1), !dbg !52
  %8 = load i32, ptr %x, align 4, !dbg !53
  %cmp5 = icmp sge i32 %8, 1, !dbg !54
  br i1 %cmp5, label %land.lhs.true, label %land.end, !dbg !55

land.lhs.true:                                    ; preds = %cond.end
  %9 = load i32, ptr %x, align 4, !dbg !56
  %cmp6 = icmp sle i32 %9, 2, !dbg !57
  br i1 %cmp6, label %land.lhs.true7, label %land.end, !dbg !58

land.lhs.true7:                                   ; preds = %land.lhs.true
  %10 = load i32, ptr %y, align 4, !dbg !59
  %cmp8 = icmp sge i32 %10, 2, !dbg !60
  br i1 %cmp8, label %land.rhs, label %land.end, !dbg !61

land.rhs:                                         ; preds = %land.lhs.true7
  %11 = load i32, ptr %y, align 4, !dbg !62
  %cmp9 = icmp sle i32 %11, 3, !dbg !63
  br label %land.end

land.end:                                         ; preds = %land.rhs, %land.lhs.true7, %land.lhs.true, %cond.end
  %12 = phi i1 [ false, %land.lhs.true7 ], [ false, %land.lhs.true ], [ false, %cond.end ], [ %cmp9, %land.rhs ], !dbg !64
  call void @svf_assert(i1 noundef zeroext %12), !dbg !65
  %13 = load i32, ptr %x, align 4, !dbg !66
  %14 = load i32, ptr %expected_x, align 4, !dbg !67
  call void @svf_assert_eq(i32 noundef %13, i32 noundef %14), !dbg !68
  %15 = load i32, ptr %y, align 4, !dbg !69
  %16 = load i32, ptr %expected_y, align 4, !dbg !70
  call void @svf_assert_eq(i32 noundef %15, i32 noundef %16), !dbg !71
  ret i32 0, !dbg !72
}

declare void @svf_print(i32 noundef, ptr noundef) #1

declare void @svf_assert(i1 noundef zeroext) #1

declare void @svf_assert_eq(i32 noundef, i32 noundef) #1

