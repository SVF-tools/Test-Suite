; ModuleID = 'test_cases_bc/ae_assert_tests/PROP_branch_switch_default.c.bc'
source_filename = "src/ae_assert_tests/PROP_branch_switch_default.c"
target datalayout = "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-n32:64-S128-Fn32"
target triple = "arm64-apple-macosx26.0.0"

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main(i32 noundef %argc, ptr noundef %argv) #0 !dbg !10 {
entry:
  %retval = alloca i32, align 4
  %argc.addr = alloca i32, align 4
  %argv.addr = alloca ptr, align 8
  %selector = alloca i32, align 4
  %expected = alloca i32, align 4
  store i32 0, ptr %retval, align 4
  store i32 %argc, ptr %argc.addr, align 4
    #dbg_declare(ptr %argc.addr, !18, !DIExpression(), !19)
  store ptr %argv, ptr %argv.addr, align 8
    #dbg_declare(ptr %argv.addr, !20, !DIExpression(), !21)
    #dbg_declare(ptr %selector, !22, !DIExpression(), !23)
  %0 = load i32, ptr %argc.addr, align 4, !dbg !24
  %cmp = icmp sgt i32 %0, 1, !dbg !25
  %1 = zext i1 %cmp to i64, !dbg !24
  %cond = select i1 %cmp, i32 -1, i32 2, !dbg !24
  store i32 %cond, ptr %selector, align 4, !dbg !23
    #dbg_declare(ptr %expected, !26, !DIExpression(), !27)
  %2 = load i32, ptr %selector, align 4, !dbg !28
  store i32 %2, ptr %expected, align 4, !dbg !27
  %3 = load i32, ptr %selector, align 4, !dbg !29
  switch i32 %3, label %sw.default [
    i32 1, label %sw.bb
  ], !dbg !30

sw.bb:                                            ; preds = %entry
  %4 = load i32, ptr %selector, align 4, !dbg !31
  %cmp1 = icmp eq i32 %4, 1, !dbg !33
  call void @svf_assert(i1 noundef zeroext %cmp1), !dbg !34
  br label %sw.epilog, !dbg !35

sw.default:                                       ; preds = %entry
  %5 = load i32, ptr %selector, align 4, !dbg !36
  %cmp2 = icmp sge i32 %5, -1, !dbg !37
  br i1 %cmp2, label %land.rhs, label %land.end, !dbg !38

land.rhs:                                         ; preds = %sw.default
  %6 = load i32, ptr %selector, align 4, !dbg !39
  %cmp3 = icmp sle i32 %6, 2, !dbg !40
  br label %land.end

land.end:                                         ; preds = %land.rhs, %sw.default
  %7 = phi i1 [ false, %sw.default ], [ %cmp3, %land.rhs ], !dbg !41
  call void @svf_assert(i1 noundef zeroext %7), !dbg !42
  %8 = load i32, ptr %selector, align 4, !dbg !43
  %9 = load i32, ptr %expected, align 4, !dbg !44
  call void @svf_assert_eq(i32 noundef %8, i32 noundef %9), !dbg !45
  br label %sw.epilog, !dbg !46

sw.epilog:                                        ; preds = %land.end, %sw.bb
  ret i32 0, !dbg !47
}

declare void @svf_assert(i1 noundef zeroext) #1

declare void @svf_assert_eq(i32 noundef, i32 noundef) #1

