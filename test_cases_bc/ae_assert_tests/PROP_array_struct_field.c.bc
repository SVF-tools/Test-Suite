%struct.Record = type { i32, [2 x i32] }

@__const.main.records = private unnamed_addr constant [2 x %struct.Record] [%struct.Record { i32 1, [2 x i32] [i32 2, i32 3] }, %struct.Record { i32 4, [2 x i32] [i32 5, i32 6] }], align 4

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main() #0 !dbg !10 {
entry:
  %retval = alloca i32, align 4
  %records = alloca [2 x %struct.Record], align 4
  store i32 0, ptr %retval, align 4
    #dbg_declare(ptr %records, !15, !DIExpression(), !24)
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %records, ptr align 4 @__const.main.records, i64 24, i1 false), !dbg !24
  %arrayidx = getelementptr inbounds [2 x %struct.Record], ptr %records, i64 0, i64 1, !dbg !25
  %data = getelementptr inbounds nuw %struct.Record, ptr %arrayidx, i32 0, i32 1, !dbg !26
  %arrayidx1 = getelementptr inbounds [2 x i32], ptr %data, i64 0, i64 1, !dbg !25
  store i32 9, ptr %arrayidx1, align 4, !dbg !27
  %arrayidx2 = getelementptr inbounds [2 x %struct.Record], ptr %records, i64 0, i64 1, !dbg !28
  %data3 = getelementptr inbounds nuw %struct.Record, ptr %arrayidx2, i32 0, i32 1, !dbg !29
  %arrayidx4 = getelementptr inbounds [2 x i32], ptr %data3, i64 0, i64 1, !dbg !28
  %0 = load i32, ptr %arrayidx4, align 4, !dbg !28
  %cmp = icmp eq i32 %0, 9, !dbg !30
  call void @svf_assert(i1 noundef zeroext %cmp), !dbg !31
  %arrayidx5 = getelementptr inbounds [2 x %struct.Record], ptr %records, i64 0, i64 1, !dbg !32
  %data6 = getelementptr inbounds nuw %struct.Record, ptr %arrayidx5, i32 0, i32 1, !dbg !33
  %arrayidx7 = getelementptr inbounds [2 x i32], ptr %data6, i64 0, i64 0, !dbg !32
  %1 = load i32, ptr %arrayidx7, align 4, !dbg !32
  %cmp8 = icmp eq i32 %1, 5, !dbg !34
  call void @svf_assert(i1 noundef zeroext %cmp8), !dbg !35
  %arrayidx9 = getelementptr inbounds [2 x %struct.Record], ptr %records, i64 0, i64 0, !dbg !36
  %data10 = getelementptr inbounds nuw %struct.Record, ptr %arrayidx9, i32 0, i32 1, !dbg !37
  %arrayidx11 = getelementptr inbounds [2 x i32], ptr %data10, i64 0, i64 1, !dbg !36
  %2 = load i32, ptr %arrayidx11, align 4, !dbg !36
  %cmp12 = icmp eq i32 %2, 3, !dbg !38
  call void @svf_assert(i1 noundef zeroext %cmp12), !dbg !39
  ret i32 0, !dbg !40
}

