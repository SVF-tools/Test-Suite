land.end:                                         ; preds = %land.rhs, %land.lhs.true4, %land.lhs.true, %entry
  %16 = phi i1 [ false, %land.lhs.true4 ], [ false, %land.lhs.true ], [ false, %entry ], [ %cmp6, %land.rhs ], !dbg !66
  call void @svf_assert(i1 noundef zeroext %16), !dbg !67
  %17 = load ptr, ptr %a, align 8, !dbg !68
  %18 = load i32, ptr %17, align 4, !dbg !69
