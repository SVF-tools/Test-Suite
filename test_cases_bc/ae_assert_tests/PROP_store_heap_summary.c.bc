  call void @svf_assert_eq(i32 noundef %21, i32 noundef %22), !dbg !75
  %23 = load ptr, ptr %a, align 8, !dbg !76
  call void @free(ptr noundef %23), !dbg !77
  %24 = load ptr, ptr %b, align 8, !dbg !78
  call void @free(ptr noundef %24), !dbg !79
