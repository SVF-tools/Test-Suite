target triple = "arm64-apple-macosx26.0.0"

%struct.Pair = type { i32, i32 }

@__const.main.pair = private unnamed_addr constant %struct.Pair { i32 1, i32 2 }, align 4

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main() #0 !dbg !10 {
entry:
  %retval = alloca i32, align 4
  %pair = alloca %struct.Pair, align 4
  store i32 0, ptr %retval, align 4
    #dbg_declare(ptr %pair, !15, !DIExpression(), !20)
  call void @llvm.memcpy.p0.p0.i64(ptr align 4 %pair, ptr align 4 @__const.main.pair, i64 8, i1 false), !dbg !20
  %left = getelementptr inbounds nuw %struct.Pair, ptr %pair, i32 0, i32 0, !dbg !21
  store i32 7, ptr %left, align 4, !dbg !22
  %left1 = getelementptr inbounds nuw %struct.Pair, ptr %pair, i32 0, i32 0, !dbg !23
  %0 = load i32, ptr %left1, align 4, !dbg !23
  %cmp = icmp eq i32 %0, 7, !dbg !24
  call void @svf_assert(i1 noundef zeroext %cmp), !dbg !25
  %right = getelementptr inbounds nuw %struct.Pair, ptr %pair, i32 0, i32 1, !dbg !26
  %1 = load i32, ptr %right, align 4, !dbg !26
  %cmp2 = icmp eq i32 %1, 2, !dbg !27
  call void @svf_assert(i1 noundef zeroext %cmp2), !dbg !28
  ret i32 0, !dbg !29
}

; Function Attrs: nocallback nofree nounwind willreturn memory(argmem: readwrite)
declare void @llvm.memcpy.p0.p0.i64(ptr noalias writeonly captures(none), ptr noalias readonly captures(none), i64, i1 immarg) #1

declare void @svf_assert(i1 noundef zeroext) #2

