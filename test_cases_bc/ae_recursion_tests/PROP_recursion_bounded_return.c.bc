define i32 @main() #0 !dbg !10 {
entry:
  %retval = alloca i32, align 4
  %result = alloca i32, align 4
  store i32 0, ptr %retval, align 4
    #dbg_declare(ptr %result, !15, !DIExpression(), !16)
  %call = call i32 @bounded_id(i32 noundef 3), !dbg !17
  store i32 %call, ptr %result, align 4, !dbg !16
  %0 = load i32, ptr %result, align 4, !dbg !18
  %cmp = icmp sge i32 %0, 0, !dbg !19
  br i1 %cmp, label %land.rhs, label %land.end, !dbg !20

land.rhs:                                         ; preds = %entry
  %1 = load i32, ptr %result, align 4, !dbg !21
  %cmp1 = icmp sle i32 %1, 2, !dbg !22
  br label %land.end

land.end:                                         ; preds = %land.rhs, %entry
  %2 = phi i1 [ false, %entry ], [ %cmp1, %land.rhs ], !dbg !23
  call void @svf_assert(i1 noundef zeroext %2), !dbg !24
  ret i32 0, !dbg !25
}

; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define internal i32 @bounded_id(i32 noundef %n) #0 !dbg !26 {
entry:
  %retval = alloca i32, align 4
  %n.addr = alloca i32, align 4
  %result = alloca i32, align 4
  store i32 %n, ptr %n.addr, align 4
    #dbg_declare(ptr %n.addr, !29, !DIExpression(), !30)
  %0 = load i32, ptr %n.addr, align 4, !dbg !31
  %cmp = icmp sle i32 %0, 0, !dbg !33
  br i1 %cmp, label %if.then, label %if.end, !dbg !33

if.then:                                          ; preds = %entry
  store i32 0, ptr %retval, align 4, !dbg !34
  br label %return, !dbg !34

if.end:                                           ; preds = %entry
    #dbg_declare(ptr %result, !35, !DIExpression(), !36)
  %1 = load i32, ptr %n.addr, align 4, !dbg !37
  %sub = sub nsw i32 %1, 1, !dbg !38
  %call = call i32 @bounded_id(i32 noundef %sub), !dbg !39
  %add = add nsw i32 %call, 1, !dbg !40
  store i32 %add, ptr %result, align 4, !dbg !36
  %2 = load i32, ptr %result, align 4, !dbg !41
  %cmp1 = icmp sgt i32 %2, 2, !dbg !43
  br i1 %cmp1, label %if.then2, label %if.end3, !dbg !43

if.then2:                                         ; preds = %if.end
  store i32 2, ptr %retval, align 4, !dbg !44
  br label %return, !dbg !44

if.end3:                                          ; preds = %if.end
  %3 = load i32, ptr %result, align 4, !dbg !45
  store i32 %3, ptr %retval, align 4, !dbg !46
  br label %return, !dbg !46

return:                                           ; preds = %if.end3, %if.then2, %if.then
  %4 = load i32, ptr %retval, align 4, !dbg !47
  ret i32 %4, !dbg !47
}

