; Function Attrs: noinline nounwind optnone ssp uwtable(sync)
define i32 @main(i32 noundef %argc, ptr noundef %argv) #0 !dbg !9 {
entry:
  %retval = alloca i32, align 4
  %argc.addr = alloca i32, align 4
  %argv.addr = alloca ptr, align 8
  %n = alloca i64, align 8
  %buffer = alloca ptr, align 8
  %source = alloca [32 x i8], align 1
  store i32 0, ptr %retval, align 4
  store i32 %argc, ptr %argc.addr, align 4
  call void @llvm.dbg.declare(metadata ptr %argc.addr, metadata !17, metadata !DIExpression()), !dbg !18
  store ptr %argv, ptr %argv.addr, align 8
  call void @llvm.dbg.declare(metadata ptr %argv.addr, metadata !19, metadata !DIExpression()), !dbg !20
  call void @llvm.dbg.declare(metadata ptr %n, metadata !21, metadata !DIExpression()), !dbg !27
  %0 = load i32, ptr %argc.addr, align 4, !dbg !28
  %cmp = icmp sgt i32 %0, 1, !dbg !29
  %1 = zext i1 %cmp to i64, !dbg !28
  %cond = select i1 %cmp, i32 1, i32 10, !dbg !28
  %conv = sext i32 %cond to i64, !dbg !28
  store i64 %conv, ptr %n, align 8, !dbg !27
  call void @llvm.dbg.declare(metadata ptr %buffer, metadata !30, metadata !DIExpression()), !dbg !31
  %2 = load i64, ptr %n, align 8, !dbg !32
  %call = call ptr @malloc(i64 noundef %2) #6, !dbg !33
  store ptr %call, ptr %buffer, align 8, !dbg !31
  call void @llvm.dbg.declare(metadata ptr %source, metadata !34, metadata !DIExpression()), !dbg !38
  call void @llvm.memset.p0.i64(ptr align 1 %source, i8 0, i64 32, i1 false), !dbg !38
  %3 = load ptr, ptr %buffer, align 8, !dbg !39
  %arraydecay = getelementptr inbounds [32 x i8], ptr %source, i64 0, i64 0, !dbg !39
  %4 = load ptr, ptr %buffer, align 8, !dbg !39
  %5 = call i64 @llvm.objectsize.i64.p0(ptr %4, i1 false, i1 true, i1 false), !dbg !39
  %call1 = call ptr @__memcpy_chk(ptr noundef %3, ptr noundef %arraydecay, i64 noundef 32, i64 noundef %5) #7, !dbg !39
  %6 = load ptr, ptr %buffer, align 8, !dbg !40
  call void @UNSAFE_BUFACCESS(ptr noundef %6, i32 noundef 31), !dbg !41
  %7 = load ptr, ptr %buffer, align 8, !dbg !42
  call void @free(ptr noundef %7), !dbg !43
  ret i32 0, !dbg !44
}

