  store i32 %argc, ptr %argc.addr, align 4
  call void @llvm.dbg.declare(metadata ptr %argc.addr, metadata !28, metadata !DIExpression()), !dbg !29
  store ptr %argv, ptr %argv.addr, align 8
  call void @llvm.dbg.declare(metadata ptr %argv.addr, metadata !30, metadata !DIExpression()), !dbg !31
  call void @llvm.dbg.declare(metadata ptr %n, metadata !32, metadata !DIExpression()), !dbg !38
  %0 = load i32, ptr %argc.addr, align 4, !dbg !39
  %cmp = icmp sgt i32 %0, 1, !dbg !40
  %1 = zext i1 %cmp to i64, !dbg !39
  %cond = select i1 %cmp, i32 4, i32 10, !dbg !39
  %conv = sext i32 %cond to i64, !dbg !39
  store i64 %conv, ptr %n, align 8, !dbg !38
  call void @llvm.dbg.declare(metadata ptr %buffer, metadata !41, metadata !DIExpression()), !dbg !42
  %2 = load i64, ptr %n, align 8, !dbg !43
  %call = call ptr @malloc(i64 noundef %2) #5, !dbg !44
  store ptr %call, ptr %buffer, align 8, !dbg !42
  %3 = load ptr, ptr %buffer, align 8, !dbg !45
  %4 = load ptr, ptr %buffer, align 8, !dbg !45
  %5 = call i64 @llvm.objectsize.i64.p0(ptr %4, i1 false, i1 true, i1 false), !dbg !45
  %call1 = call ptr @__strcpy_chk(ptr noundef %3, ptr noundef @.str, i64 noundef %5) #6, !dbg !45
  %6 = load ptr, ptr %buffer, align 8, !dbg !46
  %7 = load ptr, ptr %buffer, align 8, !dbg !46
  %8 = call i64 @llvm.objectsize.i64.p0(ptr %7, i1 false, i1 true, i1 false), !dbg !46
  %call2 = call ptr @__strcat_chk(ptr noundef %6, ptr noundef @.str.1, i64 noundef %8) #6, !dbg !46
  %9 = load ptr, ptr %buffer, align 8, !dbg !47
  call void @UNSAFE_BUFACCESS(ptr noundef %9, i32 noundef 13), !dbg !48
  %10 = load ptr, ptr %buffer, align 8, !dbg !49
  call void @free(ptr noundef %10), !dbg !50
  ret i32 0, !dbg !51
}

