set(args -overflow -stat=false)
if(CASE STREQUAL "unknown")
  list(APPEND args -ae-entry=unknown)
  set(diagnostic "AE -ae-entry='unknown' was not found")
elseif(CASE STREQUAL "declaration")
  list(APPEND args -ae-entry=declared)
  set(diagnostic "AE -ae-entry='declared' has no body")
elseif(CASE STREQUAL "declaration_qualified")
  list(APPEND args -ae-entry=m.c:declared)
  set(diagnostic "AE -ae-entry='m.c:declared' has no body")
elseif(CASE STREQUAL "modules" OR CASE STREQUAL "modules_linked")
  list(APPEND args -ae-entry=m.c:foo)
  set(diagnostic "AE -ae-entry='m.c:foo' has no definition in m.c. Definitions:")
elseif(CASE STREQUAL "conflict")
  list(APPEND args -ae-entry=declared -ae-fun-entry=no-main)
  set(diagnostic "mutually exclusive")
elseif(CASE STREQUAL "ambiguity" OR CASE STREQUAL "no_debug_ambiguity")
  list(APPEND args -ae-entry=foo)
  set(diagnostic "is ambiguous")
elseif(CASE STREQUAL "no_debug")
  list(APPEND args -ae-entry=b.c:foo)
  set(diagnostic "Compile with -g")
elseif(CASE STREQUAL "boundary")
  list(APPEND args -ae-entry=rc/b.c:foo)
  set(diagnostic "has no definition in rc/b.c. Definitions:")
elseif(CASE STREQUAL "last_colon")
  list(APPEND args -ae-entry=prefix:b.c:foo)
  set(diagnostic "has no definition in prefix:b.c. Definitions:")
elseif(CASE STREQUAL "strip_once")
  list(APPEND args -ae-entry=nested)
  set(diagnostic "was not found")
elseif(CASE STREQUAL "nonnumeric_prefix")
  list(APPEND args -ae-entry=literal)
  set(diagnostic "was not found")
else()
  list(APPEND args -ae-entry=${ENTRY} -ae-sparsity=${MODE})
endif()
execute_process(COMMAND ${AE} ${args} ${BC} ${BC2} TIMEOUT 30
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(APPEND output "\n${error}")
if(CASE)
  if(result STREQUAL "0" OR NOT output MATCHES "${diagnostic}")
    message(FATAL_ERROR "Expected error '${diagnostic}', got ${result}:\n${output}")
  endif()
  if(CASE STREQUAL "modules" OR CASE STREQUAL "modules_linked")
    if(NOT output MATCHES "foo \\(a.c:1\\)" OR
        output MATCHES "declaration only|Compile with -g")
      message(FATAL_ERROR "Expected a.c definition without declaration/debug hints:\n${output}")
    endif()
  elseif(CASE STREQUAL "declaration_qualified")
    if(output MATCHES "Compile with -g")
      message(FATAL_ERROR "Declaration must not trigger debug hint:\n${output}")
    endif()
  elseif(CASE STREQUAL "ambiguity")
    foreach(candidate "foo (/x/src/a.c:1)" "foo.1 (/x/src/b.c:2)" "file:name (needs -g)" "exact LLVM symbol")
      string(FIND "${output}" "${candidate}" found)
      if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${candidate}':\n${output}")
      endif()
    endforeach()
  elseif(CASE STREQUAL "no_debug_ambiguity")
    foreach(candidate "foo (no debug info)" "foo.1 (no debug info)")
      string(FIND "${output}" "${candidate}" found)
      if(found EQUAL -1)
        message(FATAL_ERROR "Missing '${candidate}':\n${output}")
      endif()
    endforeach()
  endif()
else()
  if(NOT result STREQUAL "0" OR output MATCHES "Assertion failure")
    message(FATAL_ERROR "AE failed (${result}):\n${output}")
  endif()
  if(EXPECT STREQUAL "assert")
    string(REGEX MATCHALL "successfully verified" verified "${output}")
    list(LENGTH verified count)
    if(NOT count EQUAL 2)
      message(FATAL_ERROR "Expected two verified assertions, got ${count}:\n${output}")
    endif()
  elseif(NOT output MATCHES "Buffer Overflow \\(1 found\\)")
    message(FATAL_ERROR "Expected buffer overflow:\n${output}")
  endif()
endif()
message(STATUS "${output}")
