set(args -overflow -stat=false)
if(CASE STREQUAL "unknown")
  list(APPEND args -ae-entry=unknown)
  set(diagnostic "AE -ae-entry='unknown' was not found")
elseif(CASE STREQUAL "declaration")
  list(APPEND args -ae-entry=declared)
  set(diagnostic "AE -ae-entry='declared' has no body")
elseif(CASE STREQUAL "conflict")
  list(APPEND args -ae-entry=declared -ae-fun-entry=no-main)
  set(diagnostic "mutually exclusive")
elseif(CASE STREQUAL "variants")
  list(APPEND args -ae-entry=foo)
  set(diagnostic "Internal-linkage variants: foo.1 foo.2")
else()
  list(APPEND args -ae-entry=${ENTRY} -ae-sparsity=${MODE})
endif()
execute_process(COMMAND ${AE} ${args} ${BC} TIMEOUT 30
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(APPEND output "\n${error}")
if(CASE)
  if(result STREQUAL "0" OR NOT output MATCHES "${diagnostic}")
    message(FATAL_ERROR "Expected error '${diagnostic}', got ${result}:\n${output}")
  endif()
else()
  if(NOT result STREQUAL "0" OR output MATCHES "Assertion failure")
    message(FATAL_ERROR "AE failed (${result}):\n${output}")
  endif()
  if(EXPECT STREQUAL "assert")
    string(REGEX MATCHALL "successfully verified" verified "${output}")
    list(LENGTH verified count)
    if(NOT count EQUAL 2)
      message(FATAL_ERROR "Expected two verified assertions, got ${count}:\n${output}")
    endif()
  elseif(NOT output MATCHES "[Bb]uffer [Oo]verflow")
    message(FATAL_ERROR "Expected buffer overflow:\n${output}")
  endif()
  if(EXPECT STREQUAL "siblings" AND
      NOT output MATCHES "selects the exact symbol. Internal-linkage variants: foo.1")
    message(FATAL_ERROR "Expected exact-match variant warning:\n${output}")
  endif()
endif()
message(STATUS "${output}")
